<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Screen flow launched from a Property: pick or add a contact, record the call outcome and notes, optionally schedule a follow-up.</description>
    <environments>Default</environments>
    <interviewLabel>Log a Call {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Log a Call</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <assignments>
        <name>Use_Existing_Contact</name>
        <label>Use Existing Contact</label>
        <locationX>308</locationX>
        <locationY>432</locationY>
        <assignmentItems>
            <assignToReference>vContactId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>ExistingContact</elementReference></value>
        </assignmentItems>
        <connector><targetReference>scrOutcome</targetReference></connector>
    </assignments>
    <choices>
        <name>chConnected</name>
        <choiceText>Connected</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Connected</stringValue></value>
    </choices>
    <choices>
        <name>chVoicemail</name>
        <choiceText>Left voicemail</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Left voicemail</stringValue></value>
    </choices>
    <choices>
        <name>chNoAnswer</name>
        <choiceText>No answer</choiceText>
        <dataType>String</dataType>
        <value><stringValue>No answer</stringValue></value>
    </choices>
    <choices>
        <name>chWrongNumber</name>
        <choiceText>Wrong number</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Wrong number</stringValue></value>
    </choices>
    <choices>
        <name>chNotInterested</name>
        <choiceText>Not interested</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Not interested</stringValue></value>
    </choices>
    <decisions>
        <name>Has_New_Contact</name>
        <label>Has New Contact</label>
        <locationX>176</locationX>
        <locationY>324</locationY>
        <defaultConnector><targetReference>Use_Existing_Contact</targetReference></defaultConnector>
        <defaultConnectorLabel>Use existing</defaultConnectorLabel>
        <rules>
            <name>New_Contact_Entered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewContactName</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>createContact</targetReference></connector>
            <label>New contact entered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Next_Step</name>
        <label>Has Next Step</label>
        <locationX>176</locationX>
        <locationY>756</locationY>
        <defaultConnector><targetReference>scrDone</targetReference></defaultConnector>
        <defaultConnectorLabel>No follow-up</defaultConnectorLabel>
        <rules>
            <name>Next_Step_Given</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NextStepDate</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>createFollowUp</targetReference></connector>
            <label>Next step given</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>csOwnerContacts</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value><elementReference>getProperty.Owner__c</elementReference></value>
        </filters>
        <object>Contact</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <formulas>
        <name>fFollowSubject</name>
        <dataType>String</dataType>
        <expression>"Follow up: " &amp; {!getProperty.Name}</expression>
    </formulas>
    <formulas>
        <name>fCallSubject</name>
        <dataType>String</dataType>
        <expression>"Call: " &amp; {!Outcome}</expression>
    </formulas>
    <formulas>
        <name>fToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <recordCreates>
        <name>createContact</name>
        <label>Create Contact</label>
        <locationX>44</locationX>
        <locationY>432</locationY>
        <assignRecordIdToReference>vContactId</assignRecordIdToReference>
        <connector><targetReference>scrOutcome</targetReference></connector>
        <inputAssignments>
            <field>AccountId</field>
            <value><elementReference>getProperty.Owner__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value><elementReference>NewContactName</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value><elementReference>NewContactPhone</elementReference></value>
        </inputAssignments>
        <object>Contact</object>
    </recordCreates>
    <recordCreates>
        <name>createCallTask</name>
        <label>Create Call Task</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <connector><targetReference>Has_Next_Step</targetReference></connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>fToday</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>Notes</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>fCallSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>TaskSubtype</field>
            <value><stringValue>Call</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>recordId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value><elementReference>vContactId</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>createFollowUp</name>
        <label>Create Follow-up Task</label>
        <locationX>44</locationX>
        <locationY>864</locationY>
        <connector><targetReference>scrDone</targetReference></connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>NextStepDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>fFollowSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>recordId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value><elementReference>vContactId</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>getProperty</name>
        <label>Get Property</label>
        <locationX>176</locationX>
        <locationY>108</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>scrContact</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Property__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>scrContact</name>
        <label>Who did you speak to?</label>
        <locationX>176</locationX>
        <locationY>216</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Has_New_Contact</targetReference></connector>
        <fields>
            <name>ExistingContact</name>
            <choiceReferences>csOwnerContacts</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Existing contact (owner account)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>NewContactName</name>
            <dataType>String</dataType>
            <fieldText>Or new contact name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>NewContactPhone</name>
            <dataType>String</dataType>
            <fieldText>New contact phone</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrOutcome</name>
        <label>Call outcome</label>
        <locationX>176</locationX>
        <locationY>540</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>createCallTask</targetReference></connector>
        <fields>
            <name>Outcome</name>
            <choiceReferences>chConnected</choiceReferences>
            <choiceReferences>chVoicemail</choiceReferences>
            <choiceReferences>chNoAnswer</choiceReferences>
            <choiceReferences>chWrongNumber</choiceReferences>
            <choiceReferences>chNotInterested</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Call outcome</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Notes</name>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>NextStepDate</name>
            <dataType>Date</dataType>
            <fieldText>Next-step date (optional)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrDone</name>
        <label>Done</label>
        <locationX>176</locationX>
        <locationY>972</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>DoneText</name>
            <fieldText>&lt;p&gt;Call logged.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>getProperty</targetReference></connector>
    </start>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
<status>Active</status>
</Flow>
