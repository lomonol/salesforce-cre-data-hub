              "value": "={{ $json.needs_review_count }}"
            },
            {
              "fieldId": "Errors__c",
              "value": "={{ $json.errors }}"
            },
            {
              "fieldId": "Status__c",
              "value": "={{ $json.status }}"
            },
            {
              "fieldId": "Error_Sample__c",
              "value": "={{ $json.error_sample }}"
            },
            {
              "fieldId": "Started_At__c",
              "value": "={{ $json.started_at }}"
            },
            {
              "fieldId": "Finished_At__c",
              "value": "={{ $json.finished_at }}"
            }
          ]
        }
      },
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Salesforce Dev (sfcre)"
        }
      }
    },
    {
